# wa-gehilfe -- Konfiguration. Kopiere diese Datei nach .env und fuelle sie.
# .env gehoert NICHT ins Repo (steht in .gitignore).

# Sprache der Oberflaeche: de oder en
SPRACHE=de

# Dein Name -- in dessen Namen die KI Entwuerfe schreibt, und der neben den
# eigenen Nachrichten steht.
EIGENER_NAME=Ich

# --- KI-Modell -------------------------------------------------------------
# Anbieter: claude (Anthropic) oder openrouter
MODELL_ANBIETER=claude
MODELL=claude-sonnet-5
# Dein API-Schluessel. PFLICHT.
MODELL_API_SCHLUESSEL=

# --- Zugang ----------------------------------------------------------------
# Anmelde-Token der Weboberflaeche. PFLICHT, mindestens 16 Zeichen.
#   erzeugen: openssl rand -base64 32
ZUGANG_TOKEN=

# Getrenntes Geheimnis fuer die Verwaltungs-Schnittstelle (/verwaltung/*).
# Leer lassen, dann gibt es die Schnittstelle nicht.
VERWALTUNG_TOKEN=

# Token zwischen Dienst und Koppler. PFLICHT, mindestens 16 Zeichen.
#   erzeugen: openssl rand -base64 32
KOPPLER_TOKEN=

# --- Optionales ------------------------------------------------------------
# Host-Port der Weboberflaeche (nur auf 127.0.0.1 gebunden).
HOST_PORT=8099

# Sprachnachrichten transkribieren: tiny | base | small (groesser = genauer,
# langsamer). Sprache leer = automatisch erkennen, oder z.B. de.
WHISPER_MODELL=base
WHISPER_SPRACHE=

# Zeitzone und Kalender-UID-Domain (nur ein Bezeichner, kein Netzzugriff).
TZ=Europe/Zurich
KALENDER_DOMAIN=wa-gehilfe.local

# Nur falls Cloudflare Access davorsteht:
CF_ACCESS_TEAM=
CF_ACCESS_AUD=

# --- Benachrichtigungen (optional) -----------------------------------------
# POST bei eingehender Nachricht, ntfy-kompatibel. Empfohlen: selbst gehostetes
# ntfy (github.com/binwiederhier/ntfy) + die ntfy-App (Android/iOS). Leer = aus.
#   Beispiel: https://ntfy.dein-host.tld/mein-geheimes-topic
BENACHRICHTIGUNG_URL=
# Inhalt der Nachricht mitschicken? Vorgabe nein -- dann nur "Neue Nachricht
# von X". ja = Vorschau (verlaesst die eigene Maschine).
BENACHRICHTIGUNG_VORSCHAU=
# Auch bei Gruppennachrichten benachrichtigen? Vorgabe nein.
BENACHRICHTIGUNG_GRUPPEN=
# Prioritaet (ntfy: min|low|default|high|max)
BENACHRICHTIGUNG_PRIO=default

# Nur fuer den optionalen Cloudflare-Tunnel in docker-compose.yml:
TUNNEL_TOKEN=

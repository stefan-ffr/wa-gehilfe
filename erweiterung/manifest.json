{
  "manifest_version": 3,
  "name": "WhatsApp-Entwurfshilfe",
  "version": "0.2.0",
  "description": "Holt einen Antwortentwurf und tippt ihn ins Eingabefeld. Sendet nichts von allein.",
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "hintergrund.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["inhalt.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "einstellungen.html"
}
